+/* Expose the actual Q35 ACPI PM timer through the AMD PMIO index registers. */
+static uint64_t ich9_amd_pmio_read(void *opaque, hwaddr addr, unsigned len)
+{
+    ICH9LPCState *lpc = opaque;
+    unsigned timer_port = lpc->pm.pm_io_base ? lpc->pm.pm_io_base + 8 : 0;
+
+    if (addr == 0) {
+        return lpc->amd_pmio_index;
+    }
+    if (lpc->amd_pmio_index == 0x64) {
+        return timer_port & 0xff;
+    }
+    if (lpc->amd_pmio_index == 0x65) {
+        return timer_port >> 8;
+    }
+    return 0xff;
+}
+
+static void ich9_amd_pmio_write(void *opaque, hwaddr addr, uint64_t data,
+                                unsigned len)
+{
+    ICH9LPCState *lpc = opaque;
+
+    if (addr == 0) {
+        lpc->amd_pmio_index = data;
+    }
+}
+
+static const MemoryRegionOps ich9_amd_pmio_ops = {
+    .read = ich9_amd_pmio_read,
+    .write = ich9_amd_pmio_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 1,
+    .valid.max_access_size = 1,
+};
+
+/* Diagnostic-only absent EC transport. Payloads remain unmapped (0xff). */
+static uint64_t ec_absent_status(void *opaque, hwaddr addr, unsigned len)
+{
+    ICH9LPCState *lpc = opaque;
+    /* Output buffer full while the unavailable reply can be drained. */
+    return lpc->ec_remaining ? 1 : 0;
+}
+
+static uint64_t ec_absent_data(void *opaque, hwaddr addr, unsigned len)
+{
+    ICH9LPCState *lpc = opaque;
+    if (lpc->ec_remaining) {
+        --lpc->ec_remaining;
+    }
+    return 0xff;
+}
+
+static void ec_absent_command(void *opaque, hwaddr addr, uint64_t data,
+                              unsigned len)
+{
+    ICH9LPCState *lpc = opaque;
+    /* Bound the reply window for the vendor's multi-byte EEPROM queries.
+     * The guest receives only the open-bus value, never board data. */
+    lpc->ec_remaining = 32;
+}
+
+static void ec_absent_write(void *opaque, hwaddr addr, uint64_t data,
+                            unsigned len)
+{
+}
+
+static const MemoryRegionOps ec_absent_command_ops = {
+    .read = ec_absent_status,
+    .write = ec_absent_command,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 1,
+    .valid.max_access_size = 1,
+};
+
+static const MemoryRegionOps ec_absent_data_ops = {
+    .read = ec_absent_data,
+    .write = ec_absent_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 1,
+    .valid.max_access_size = 1,
 };
 
